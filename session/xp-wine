#!/usr/bin/env bash
# xp-wine — kendi XP kopyandaki gerçek XP programlarını (Hesap Makinesi, Paint, WordPad, Mayın Tarlası,
# Solitaire, Pinball…) Wine ile, XP'nin Luna temasıyla çalıştırır.
#
#   xp-wine calc.exe            programı çalıştır (ilk seferde Wine ön eki kurulur)
#   xp-wine --kur               yalnızca ön eki kur / güncelle
#
# Ön ek: ~/.local/share/xpthemeplasma/wine (Windows sürümü: XP, tema: luna.msstyles, XP yazı tipleri).
# Programlar ve gerekli DLL'ler (mfc42u, cards) C:\windows\xp altına kopyalanır.
set -u
VERI="${XDG_DATA_HOME:-$HOME/.local/share}/xpthemeplasma"
XPD="$VERI/xp"
export WINEPREFIX="$VERI/wine"
export WINEDEBUG=-all
# Mono/Gecko kurulum pencereleri çıkmasın; MFC ve kart kitaplığı XP'ninki olsun
export WINEDLLOVERRIDES="mscoree,mshtml=;mfc42u,mfc42,cards,getuname=n,b"
PROG="$WINEPREFIX/drive_c/windows/xp"
SURUM=3     # ön ek düzeni değişince artır

kur() {
    command -v wine >/dev/null || { echo "Wine kurulu değil (sudo pacman -S wine)" >&2; exit 1; }
    [ -f "$XPD/stil/luna.msstyles" ] || { echo "XP varlıkları yok: bash kur.sh --xp <ISO>" >&2; exit 1; }
    if [ ! -f "$WINEPREFIX/system.reg" ]; then
        env -u DISPLAY -u WAYLAND_DISPLAY wineboot -i >/dev/null 2>&1
    fi
    mkdir -p "$WINEPREFIX/drive_c/windows/Resources/Themes/Luna" "$PROG/pinball"
    cp -f "$XPD/stil/luna.msstyles" "$WINEPREFIX/drive_c/windows/Resources/Themes/Luna/Luna.msstyles"
    # XP yazı tipleri (Tahoma, Trebuchet, Franklin Gothic, Arial…)
    cp -f "$XPD"/font/*.ttf "$WINEPREFIX/drive_c/windows/Fonts/" 2>/dev/null
    for f in calc.exe mspaint.exe wordpad.exe charmap.exe sndrec32.exe winmine.exe sol.exe freecell.exe \
             mshearts.exe spider.exe cards.dll mfc42u.dll mfc42.dll getuname.dll; do
        [ -f "$XPD/ikon/$f" ] && cp -f "$XPD/ikon/$f" "$PROG/$f"
    done
    if [ -f "$XPD/ikon/pinball.exe" ]; then
        cp -f "$XPD/ikon/pinball.exe" "$PROG/pinball/"
        cp -f "$XPD"/program/* "$PROG/pinball/" 2>/dev/null
        cp -f "$XPD"/ses/sound*.wav "$PROG/pinball/" 2>/dev/null
    fi
    local reg="$WINEPREFIX/xp.reg"
    cat > "$reg" <<'EOF'
REGEDIT4

[HKEY_CURRENT_USER\Software\Wine]
"Version"="winxp"

[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\ThemeManager]
"ThemeActive"="1"
"DllName"="C:\\windows\\Resources\\Themes\\Luna\\Luna.msstyles"
"ColorName"="NormalColor"
"SizeName"="NormalSize"
"LoadedBefore"="1"

[HKEY_CURRENT_USER\Control Panel\Desktop]
"FontSmoothing"="2"
"FontSmoothingType"=dword:00000001

[HKEY_CURRENT_USER\Software\Wine\X11 Driver]
"Decorated"="Y"
"Managed"="Y"

[HKEY_CURRENT_USER\Software\Microsoft\Windows NT\CurrentVersion\Winlogon]
"Shell"="explorer.exe"
EOF
    env -u DISPLAY -u WAYLAND_DISPLAY wine regedit /S "$(winepath -w "$reg" 2>/dev/null || echo 'C:\xp.reg')" >/dev/null 2>&1
    wineserver -w 2>/dev/null
    echo "$SURUM" > "$WINEPREFIX/.xp-surum"
}

if [ "${1:-}" = "--kur" ]; then
    kur
    exit 0
fi
[ "$(cat "$WINEPREFIX/.xp-surum" 2>/dev/null)" = "$SURUM" ] || kur
exe="${1:-}"
[ -n "$exe" ] || { echo "kullanım: xp-wine <program.exe>" >&2; exit 1; }
shift
if [ "$exe" = "pinball.exe" ]; then
    cd "$PROG/pinball" && exec wine pinball.exe "$@"
fi
# bir dosya açılacaksa (ör. Paint ile resim) Windows yoluna çevir
args=()
for a in "$@"; do
    if [ -e "$a" ]; then args+=("$(winepath -w "$a" 2>/dev/null)"); else args+=("$a"); fi
done
cd "$PROG" && exec wine "$exe" "${args[@]}"
