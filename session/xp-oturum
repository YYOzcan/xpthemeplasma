#!/bin/sh
# XPThemePlasma Wayland oturumu (SDDM: "XPThemePlasma (Wayland)")
# Tema anahtarlarının değiştirilmesi ~/.config/plasma-workspace/env/xpthemeplasma.sh içinde yapılır.
export PLASMA_DEFAULT_SHELL=io.github.yyozcan.xpshell
export XPTHEMEPLASMA_SESSION=1
# XP varsayılanları (simge teması, oturum kapatma onayı, "Bu sistem hakkında" adı)
export XDG_CONFIG_DIRS="$HOME/.local/share/xpthemeplasma/xdg:${XDG_CONFIG_DIRS:-/etc/xdg}"
# yalnızca XP oturumunda görünen programlar (Not Defteri vb.)
export XDG_DATA_DIRS="$HOME/.local/share/xpthemeplasma/data:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
# XP yazı tipi işleme (küçük Tahoma kenar yumuşatmasız) — yalnızca bu oturumda
[ -f "$HOME/.local/share/xpthemeplasma/fonts.conf" ] && export FONTCONFIG_FILE="$HOME/.local/share/xpthemeplasma/fonts.conf"
/usr/lib/plasma-dbus-run-session-if-needed /usr/bin/startplasma-wayland
# düzgün oturum kapatmada önceki temayı hemen geri yükle
[ -x "$HOME/.local/bin/xp-profil" ] && "$HOME/.local/bin/xp-profil" geri >/dev/null 2>&1
exit 0
