#!/bin/sh
# XPThemePlasma Wayland oturumu (SDDM: "XPThemePlasma (Wayland)")
# Asıl mantık kullanıcı tarafında: ~/.local/bin/xp-oturum (güncellemeler için sudo gerekmez)
if [ -x "$HOME/.local/bin/xp-oturum" ]; then
    exec "$HOME/.local/bin/xp-oturum"
fi
export PLASMA_DEFAULT_SHELL=io.github.yyozcan.xpshell
exec /usr/lib/plasma-dbus-run-session-if-needed /usr/bin/startplasma-wayland
