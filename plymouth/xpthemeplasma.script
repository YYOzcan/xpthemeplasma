# XPThemePlasma — Windows XP açılış ekranı
Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

W = Window.GetWidth();
H = Window.GetHeight();
k = Math.Min(W / 640, H / 480);         # 4:3 korunur, yanlar siyah
ox = Math.Int((W - 640 * k) / 2);
oy = Math.Int((H - 480 * k) / 2);

ekran = Sprite(Image("boot.png").Scale(Math.Int(640 * k), Math.Int(480 * k)));
ekran.SetX(ox);
ekran.SetY(oy);
ekran.SetZ(0);

for (i = 0; i < 19; i++) {
    ad = "kare-" + (i < 10 ? "0" : "") + i + ".png";
    kare[i] = Image(ad).Scale(Math.Int(120 * k), Math.Int(9 * k));
}
bar = Sprite(kare[0]);
bar.SetX(ox + Math.Int(258 * k));
bar.SetY(oy + Math.Int(354 * k));
bar.SetZ(1);

sayac = 0;
adim = 0;
fun guncelle() {
    sayac++;
    if (sayac % 3 == 0) {               # ~50 ms'de bir 8 piksel (XP hızı)
        adim = (adim + 1) % 19;
        bar.SetImage(kare[adim]);
    }
}
Plymouth.SetRefreshFunction(guncelle);

# --- parola (şifreli disk varsa) ---
fun parola(istem, madde) {
    yildiz = "";
    for (j = 0; j < madde; j++) yildiz += "*";
    global.p_sprite = Sprite(Image.Text(istem + " " + yildiz, 1, 1, 1));
    global.p_sprite.SetX(Math.Int(W / 2 - 150));
    global.p_sprite.SetY(Math.Int(oy + 400 * k));
    global.p_sprite.SetZ(10);
}
Plymouth.SetDisplayPasswordFunction(parola);

fun normal() {
    global.p_sprite = NULL;
}
Plymouth.SetDisplayNormalFunction(normal);

fun ileti(metin) {
    global.m_sprite = Sprite(Image.Text(metin, 0.7, 0.7, 0.7));
    global.m_sprite.SetX(10);
    global.m_sprite.SetY(H - 20);
    global.m_sprite.SetZ(10);
}
Plymouth.SetMessageFunction(ileti);
